{
  "name": "tibia-dungeons",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others-on-fail --names API,ANGULAR \"npm:start:server\" \"npm:start:angular\"",
    "start:angular": "ng serve --port=4300 --proxy-config proxy.conf.json",
    "start:server": "node --env-file-if-exists=.env.local server/index.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "pg": "^8.23.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "^10.0.7",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
